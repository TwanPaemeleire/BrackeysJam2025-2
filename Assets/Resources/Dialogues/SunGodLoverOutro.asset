MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5ecec16b8ee942e4eb0d813ea7ecc6c1, type: 3}
  m_Name: SunGodLoverOutro
  m_EditorClassIdentifier: Assembly-CSharp::Assets.Dialogues.DialogueData
  dialogueID: SunGodLoverOutro
  lines:
  - characterPortrait: {fileID: 21300000, guid: f6108cd31ffa6a1449af93fa1646ba04, type: 3}
    characterName: Solareo
    text: LET'S GOOOOOOO! Good job! Damn, you fought like a beast!
  - characterPortrait: {fileID: 0}
    characterName: You
    text: Jeez.. this was tense. You did not hold back or what?
  - characterPortrait: {fileID: 21300000, guid: f6108cd31ffa6a1449af93fa1646ba04, type: 3}
    characterName: Solareo
    text: Why would I?
  - characterPortrait: {fileID: 0}
    characterName: You
    text: ...
  - characterPortrait: {fileID: 0}
    characterName: You
    text: 'Bruh. But alright. Was fun for sure. '
  - characterPortrait: {fileID: 0}
    characterName: You
    text: So now what, I get to become a God?
  - characterPortrait: {fileID: 21300000, guid: f6108cd31ffa6a1449af93fa1646ba04, type: 3}
    characterName: Solareo
    text: Corrrrrect. You are now not only my equal, but you also get to rule THE
      WORLD!
  - characterPortrait: {fileID: 0}
    characterName: You
    text: Why do I feel you're going to be the death of me?
  - characterPortrait: {fileID: 21300000, guid: f3223f1c54195dd4d9a6c84da323df58, type: 3}
    characterName: Neruna
    text: Do not underestimate the responsibility that you get with the ascension.
  - characterPortrait: {fileID: 21300000, guid: f6108cd31ffa6a1449af93fa1646ba04, type: 3}
    characterName: Solareo
    text: Yeah yeah, nevermind! Let's go! This is where the fun begins!
